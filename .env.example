# Public URL of the marketing site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com
# Base URL of the HelloKhata API. Leave empty to keep forms in "not connected" mode.
NEXT_PUBLIC_HELLOKHATA_API_URL=
# URL of the HelloKhata web app (sign-in / sign-up handoff). Optional.
NEXT_PUBLIC_HELLOKHATA_APP_URL=
